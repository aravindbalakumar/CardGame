.block-icon { background-image: url("project://database/Assets/Sprites/UI/wmremove-transformed%201.png?fileID=-754423547&guid=c62900b22a88976428ebb01509d9ebf8&type=3#wmremove-transformed%201_24"); }
.end-turn { background-image: url("project://database/Assets/Sprites/UI/wmremove-transformed%201.png?fileID=-1907696705&guid=c62900b22a88976428ebb01509d9ebf8&type=3#wmremove-transformed%201_12"); }

/* Reference artboard: 1672 x 941. PanelSettings scales these logical units. */
.game-root { --gold: rgb(205, 173, 127); }
.top-bar { height: 62px; padding: 5px 64px 5px 15px; -unity-background-image-tint-color: rgb(92, 89, 83); }
.portrait { width: 48px; height: 48px; margin-right: 35px; -unity-background-image-tint-color: rgb(184, 174, 151); }
.heart { width: 38px; height: 38px; -unity-background-image-tint-color: rgb(179, 142, 122); }
.health-text { font-size: 28px; margin-right: 30px; }
.currency { width: 28px; height: 39px; -unity-background-image-tint-color: rgb(210, 103, 62); }
.nav-button { width: 42px; height: 42px; margin: 0 4px; -unity-background-image-tint-color: rgb(171, 160, 139); }
.inventory { top: 10px; left: 18px; height: 52px; }
.inventory-icon { width: 47px; height: 51px; margin-right: 15px; -unity-background-image-tint-color: rgb(184, 170, 145); }
.arena { padding-right: 36px; }
.intent-column { width: 162px; margin-left: 0; padding-top: 9px; padding-bottom: 0; }
.map { width: 162px; height: 122px; }
.enemy-status { top: 3px; right: 0; width: 194px; }
.enemy-crest { width: 92px; height: 91px; -unity-background-image-tint-color: rgb(166, 153, 131); }
.enemy-name { font-size: 24px; height: 29px; margin: 0; padding: 0; }
.health-track { height: 21px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); overflow: visible; }
.health-fill { background-color: rgba(0, 0, 0, 0); -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0; -unity-background-image-tint-color: rgb(216, 115, 85); }
.health-value { font-size: 24px; }
.intent-heading { height: 72px; }
.attack-icon { width: 62px; height: 56px; -unity-background-image-tint-color: rgb(190, 165, 130); }
.intent-note { font-size: 17px; -unity-font-style: normal; padding: 12px 8px; margin: 3px 0; min-height: 82px; }
.special-note { min-height: 104px; }
.turn-badge { border-color: rgb(73, 67, 54); font-size: 24px; }
.bottom-area { height: 275px; padding: 0 68px 0 32px; }
.player-status { width: 334px; flex-shrink: 0; padding-top: 19px; }
.player-health-track { width: 198px; height: 21px; }
.block-row { margin-top: 3px; }
.block-icon { width: 33px; height: 36px; }
.block-text { font-size: 25px; }
.energy-orb { margin: 19px 0 0 38px; width: 116px; height: 116px; border-width: 6px; border-color: rgb(91, 91, 82); background-color: rgb(5, 36, 47); }
.active-player .energy-orb { border-color: rgb(115, 108, 92); }
.orb-rim { border-width: 3px; border-color: rgb(44, 44, 42); border-top-color: rgb(157, 148, 127); border-bottom-color: rgb(94, 88, 75); }
.orb-inner { border-color: rgb(19, 62, 72); border-bottom-color: rgb(7, 27, 35); }
.energy-value { font-size: 48px; }
.energy-caption { width: 192px; font-size: 24px; }
.hand { padding-top: 11px; padding-bottom: 3px; }
.hand-region { margin-right: 30px; }
.hand-card { width: 180px; height: 254px; min-width: 110px; margin: 0 -1px; }
.card-description { top: 68%; bottom: 8%; font-size: 15px; padding: 0 4px; }
.controls { width: 254px; padding: 0 0 23px 0; }
.end-turn { height: 81px; margin-bottom: 19px; font-size: 31px; -unity-slice-scale: 0.5; }
.pile-row { height: 98px; }
.pile { width: 117px; height: 98px; flex-basis: 117px; flex-grow: 0; flex-shrink: 1; min-width: 0; margin: 0 5px; border-width: 2px; border-color: rgb(71, 64, 52); background-color: rgba(7, 9, 10, 0.82); border-radius: 5px; }
.pile-count { font-size: 27px; right: 8px; bottom: 4px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.deck-stack { width: 38px; height: 52px; margin: 10px 12px 0 0; border-color: rgb(111, 103, 83); rotate: -20deg; background-color: rgb(20, 21, 20); }
.deck-stack-inner { left: 8px; top: -4px; width: 38px; height: 52px; rotate: 12deg; border-color: rgb(100, 92, 75); background-color: rgb(29, 28, 24); }
.deck-stack-front { position: absolute; left: 16px; top: -3px; width: 38px; height: 52px; rotate: 25deg; border-width: 2px; border-color: rgb(100, 92, 75); background-color: rgb(27, 26, 23); }
.discard-bin { width: 35px; height: 46px; margin-top: 17px; border-width: 3px; border-top-width: 2px; border-color: rgb(105, 101, 88); border-bottom-color: rgb(66, 64, 56); border-radius: 4px 4px 12px 12px; background-color: rgb(27, 28, 26); }
.bin-rim { position: absolute; top: -7px; left: -7px; right: -7px; height: 9px; border-radius: 50%; border-width: 2px; border-color: rgb(117, 108, 91); background-color: rgb(14, 15, 14); }
.bin-line { position: absolute; top: 5px; bottom: 5px; left: 45%; width: 2px; background-color: rgb(95, 91, 78); }
.bin-line-left { left: 20%; rotate: -5deg; }
.bin-line-right { left: 72%; rotate: 5deg; }

/* Wider/taller panels retain the established hierarchy; small panels reflow. */
.compact .player-status { width: 20%; }
.compact .hand-region { margin-right: 15px; }
.compact .controls { width: 19%; padding-left: 8px; }
.narrow .player-status { width: 19%; }
.narrow .hand-region { margin-right: 8px; }
.narrow .controls { width: 20%; }
.portrait-layout .player-status { width: 28%; }
.portrait-layout .controls { width: 100%; }

/* Complete 416 x 716 card faces. Fixed geometry keeps every card readable as the hand grows. */
.bottom-area { height: 324px; padding-right: 32px; }
.player-status { width: 230px; }
.controls { width: 210px; }
.hand-region { margin-right: 22px; }
.hand-scroll .unity-scroll-view__content-viewport { overflow: hidden; }
.hand-scroll .unity-scroll-view__content-container { flex-grow: 1; align-items: stretch; }
.hand { flex-shrink: 0; min-width: 100%; padding: 24px 8px 8px; align-items: flex-end; }
.hand-card { width: 162px; min-width: 162px; height: 279px; flex-shrink: 0; margin: 0 6px; border-width: 0; border-radius: 6px; }
.hand-card.card-first, .hand-card.card-last { rotate: 0; translate: 0 0; }
.hand-card:hover { translate: 0 -8px; scale: 1 1; }
.hand-card.selected { translate: 0 -12px; border-width: 0; }
.hand-card:focus { border-width: 0; }
.hand-card:focus { background-color: rgb(206, 170, 119); }

.preview-card .card-title, .preview-card .card-cost, .preview-card .card-art,
.preview-card .card-description, .preview-card .card-kind { display: none; }
.data-card .card-art { display: none; }
.data-card .card-title { left: 28%; right: 8%; top: 11%; height: 6%; margin: 0; padding: 0; font-size: 14px; background-color: rgb(17, 16, 13); color: rgb(247, 230, 182); }
.data-card .card-cost { left: 9%; top: 8%; width: 15%; height: 9%; margin: 0; padding: 0; font-size: 24px; color: rgb(255, 239, 202); background-color: rgb(111, 14, 14); }
.card-kind { position: absolute; left: 12%; right: 10%; top: 72%; height: 8%; margin: 0; padding: 0; font-size: 11px; -unity-text-align: middle-center; color: rgb(247, 230, 182); background-color: rgb(17, 16, 13); }
.data-card .card-description { left: 11%; right: 10%; top: 81%; bottom: 8%; margin: 0; padding: 0 2px; font-size: 11px; color: rgb(247, 230, 182); background-color: rgb(17, 16, 13); }
.missing-face { background-color: rgb(26, 20, 15); border-color: var(--gold); border-width: 1px; }
.missing-face .card-art { display: flex; top: 20%; height: 50%; }
.hand-empty { position: absolute; left: 0; right: 0; top: 45%; -unity-text-align: middle-center; color: var(--muted); }
.compact .bottom-area, .narrow .bottom-area { height: 292px; flex-wrap: nowrap; }
.compact .hand-card, .narrow .hand-card { width: 145px; min-width: 145px; height: 250px; }
.compact .hand-card .card-title { font-size: 12px; }
.compact .hand-card .card-description { font-size: 10px; }
.portrait-layout .bottom-area { height: 410px; flex-wrap: wrap; }
.portrait-layout .hand-region { width: 72%; height: 292px; margin-right: 0; }
.portrait-layout .controls { height: 110px; }
