.game-root {
    --gold: rgb(206, 170, 119);
    --muted: rgb(149, 130, 103);
    --ink: rgb(34, 21, 12);
    --crimson: rgb(145, 39, 28);
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: var(--gold);
    -unity-font-definition: url("../../Font/CrimsonText/CrimsonText-Regular.ttf");
    font-size: 20px;
}
.top-bar { height: 62px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 5px 20px 5px 10px; background-size: 100% 100%; }
.portrait { width: 48px; height: 48px; margin-right: 20px; }
.icon { width: 38px; height: 40px; margin-right: 9px; }
.health-text { color: rgb(179, 64, 43); font-size: 26px; margin-right: 32px; }
.stat-text { font-size: 25px; }
.spacer { flex-grow: 1; }
.eyebrow { font-size: 10px; letter-spacing: 2px; color: var(--muted); -unity-text-align: middle-center; }
.preview-label { display: none; }
.nav-button { width: 44px; height: 44px; margin: 0 4px; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); background-size: contain; background-repeat: no-repeat; background-position: center; }
.nav-button:hover { -unity-background-image-tint-color: rgb(255, 219, 158); scale: 1.08 1.08; }
.nav-button:active { scale: 0.96 0.96; }
.nav-button:disabled { opacity: 1; }
.arena { flex-grow: 1; min-height: 0; flex-direction: row; padding-right: 28px; }
.inventory { position: absolute; top: 12px; left: 14px; flex-direction: row; align-items: center; height: 55px; }
.inventory-icon { width: 49px; height: 49px; margin-right: 13px; }
.small-count { font-size: 18px; margin-left: -18px; margin-top: 25px; margin-right: 12px; }
.battlefield { flex-grow: 1; flex-direction: row; min-width: 0; }
.hero-space { width: 47%; justify-content: flex-end; }
.enemy-space { flex-grow: 1; justify-content: flex-end; }
.enemy-status { position: absolute; top: 4px; right: 5px; width: 205px; align-items: center; }
.enemy-crest { width: 89px; height: 91px; }
.enemy-name { font-size: 21px; -unity-text-align: middle-center; margin: -2px 0 0 0; }
.health-track { width: 100%; height: 25px; justify-content: center; background-color: rgb(32, 13, 13); border-width: 1px; border-color: rgb(72, 58, 42); border-radius: 10px; overflow: hidden; }
.health-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: var(--crimson); background-size: 100% 100%; }
.health-value { font-size: 21px; -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(8, 5, 4); margin: 0; padding: 0; }
.intent-column { width: 170px; flex-shrink: 0; padding-top: 10px; padding-bottom: 8px; margin-left: 18px; }
.map { width: 170px; height: 130px; }
.intent-heading { flex-direction: row; align-items: center; justify-content: center; height: 66px; }
.attack-icon { width: 61px; height: 57px; margin-right: 9px; }
.turn-badge { border-width: 2px; border-color: rgb(89, 72, 49); border-radius: 22px; width: 43px; height: 43px; -unity-text-align: middle-center; font-size: 21px; background-color: rgba(8, 10, 12, 0.9); }
.parchment { background-size: 100% 100%; color: var(--ink); }
.intent-note { min-height: 82px; white-space: normal; font-size: 14px; -unity-text-align: middle-center; padding: 13px 9px; margin: 3px 0; -unity-font-definition: url("../../Font/CrimsonText/CrimsonText-Regular.ttf"); -unity-font-style: bold; }
.special-note { min-height: 104px; }
.bottom-area { height: 275px; flex-shrink: 0; flex-direction: row; padding: 0 28px 5px 32px; background-color: rgba(0, 0, 0, 0.30); }
.player-status { width: 21%; padding-top: 12px; align-items: flex-start; }
.player-health-track { width: 200px; height: 24px; }
.block-row { flex-direction: row; align-items: center; margin-top: 5px; }
.block-icon { width: 33px; height: 36px; margin-right: 8px; }
.block-text { font-size: 22px; }
.energy-orb { width: 116px; height: 116px; margin: 15px 0 0 32px; background-color: rgb(7, 36, 46); border-width: 5px; border-color: rgb(99, 95, 81); border-radius: 60px; justify-content: center; align-items: center; }
.energy-value { font-size: 43px; color: rgb(216, 190, 151); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); }
.energy-caption { width: 180px; -unity-text-align: middle-center; font-size: 21px; margin-top: 3px; }
.hand-region { flex-grow: 1; min-width: 0; }
.selection-hint { position: absolute; bottom: 100%; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; height: 26px; color: rgb(234, 208, 153); }
.hand-scroll { flex-grow: 1; }
.hand-scroll .unity-scroll-view__content-container { flex-grow: 1; flex-direction: row; align-items: flex-end; }
.hand-scroll .unity-scroll-view__content-viewport { overflow: visible; }
.hand-scroll .unity-scroller--horizontal { height: 12px; background-color: rgb(15, 16, 17); }
.hand-scroll .unity-scroller__low-button, .hand-scroll .unity-scroller__high-button { background-color: rgb(52, 41, 28); border-width: 0; }
.hand-scroll .unity-base-slider__tracker { background-color: rgb(29, 26, 22); }
.hand-scroll .unity-base-slider__dragger { background-color: rgb(111, 91, 60); border-width: 0; }
.hand { flex-direction: row; align-items: flex-end; justify-content: center; flex-grow: 1; padding-top: 15px; padding-bottom: 4px; }
.hand-card { position: relative; width: 178px; height: 252px; min-width: 125px; flex-shrink: 1; padding: 0; margin: 0 -2px; border-width: 0; border-radius: 8px; background-color: rgba(0, 0, 0, 0); background-size: 100% 100%; transition-property: translate, scale, -unity-background-image-tint-color; transition-duration: 0.13s; }
.hand-card.card-first { rotate: -3deg; translate: 0 5px; }
.hand-card.card-last { rotate: 3deg; translate: 0 5px; }
.hand-card:hover { translate: 0 -14px; scale: 1.035 1.035; -unity-background-image-tint-color: rgb(255, 226, 179); }
.hand-card:active { scale: 0.98 0.98; }
.hand-card.selected { translate: 0 -19px; border-width: 2px; border-color: rgb(226, 184, 102); }
.hand-card:disabled { opacity: 0.48; }
.hand-card.preview-card { -unity-background-image-tint-color: rgb(255, 255, 255); }
.card-art { position: absolute; left: 11%; top: 16%; width: 78%; height: 45%; }
.card-frame { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.card-title { position: absolute; left: 18%; right: 7%; top: 4%; height: 11%; font-size: 16px; background-color: rgb(60, 38, 22); -unity-text-align: middle-center; }
.card-cost { position: absolute; left: 5%; top: 3%; width: 17%; height: 12%; font-size: 22px; -unity-text-align: middle-center; background-color: rgb(60, 38, 22); border-radius: 16px; }
.card-description { position: absolute; left: 11%; right: 10%; top: 66%; bottom: 8%; white-space: normal; -unity-text-align: middle-center; color: var(--ink); font-size: 14px; -unity-font-definition: url("../../Font/CrimsonText/CrimsonText-Regular.ttf"); }
.preview-card .card-title, .preview-card .card-cost, .preview-card .card-art { display: none; }
.controls { width: 18%; flex-shrink: 0; justify-content: flex-end; padding: 0 10px 12px 25px; }
.end-turn { height: 80px; margin: 0 0 18px 0; padding: 0; background-color: rgba(0, 0, 0, 0); background-size: 100% 100%; border-width: 0; color: var(--gold); font-size: 27px; -unity-text-align: middle-center; }
.end-turn:hover { -unity-background-image-tint-color: rgb(255, 220, 161); color: rgb(255, 221, 171); }
.end-turn:active { scale: 0.97 0.97; }
.end-turn:disabled { opacity: 1; }
.pile-row { flex-direction: row; justify-content: space-between; }
.pile { flex-grow: 1; height: 93px; margin: 0 3px; padding: 8px; border-width: 2px; border-color: rgb(77, 64, 47); border-radius: 4px; background-color: rgb(11, 12, 14); align-items: center; }
.pile:hover { border-color: var(--gold); }
.pile-symbol { font-size: 28px; color: var(--muted); }
.pile-count { position: absolute; right: 8px; bottom: 2px; font-size: 24px; }
.unavailable { opacity: 1; }
.actor-target { position: absolute; bottom: 4%; width: 64%; height: 55%; background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0; padding: 0; }
.self-target { right: 4%; }
.enemy-target { right: 0; width: 90%; }
.actor-target:disabled { display: none; }
.actor-target:hover { border-width: 1px; border-color: rgba(224, 184, 106, 0.7); background-color: rgba(197, 162, 99, 0.06); border-radius: 18px; }
.inactive-player { opacity: 0.55; }
.active-player .energy-orb { border-color: rgb(132, 119, 92); }
.options-panel { position: absolute; right: 30px; top: 72px; width: 340px; max-height: 78%; padding: 24px; background-color: rgb(12, 15, 18); border-width: 1px; border-color: var(--gold); border-radius: 6px; }
.panel-title { font-size: 24px; margin-bottom: 12px; }
.options-help { white-space: normal; font-size: 14px; margin: 14px 0; -unity-font-definition: url("../../Font/CrimsonText/CrimsonText-Regular.ttf"); }
.panel-button { height: 34px; color: var(--gold); background-color: rgb(43, 31, 22); border-color: var(--muted); }
.animation-status { font-size: 13px; margin: 7px 0; -unity-font-definition: url("../../Font/CrimsonText/CrimsonText-Regular.ttf"); }
.animation-buttons { max-height: 250px; margin-bottom: 8px; }
.animation-choice { min-height: 34px; flex-shrink: 0; margin: 2px 0; color: var(--gold); background-color: rgb(24, 23, 21); border-color: rgb(77, 64, 47); -unity-text-align: middle-left; }
.animation-choice:hover { border-color: var(--gold); background-color: rgb(43, 31, 22); }
.animation-choice:disabled { opacity: 0.45; }
.options-section { margin-top: 14px; }
.hidden { display: none; }
.compact .bottom-area { height: 240px; padding-left: 20px; padding-right: 16px; }
.compact .player-status { width: 17%; }
.compact .player-health-track { width: 150px; }
.compact .hand-card { width: 158px; height: 220px; }
.compact .intent-column { width: 150px; margin-left: 8px; }
.compact .map { width: 150px; height: 110px; }
.compact .intent-note { min-height: 65px; font-size: 13px; padding: 9px; }
.compact .special-note { min-height: 80px; }
.compact .controls { padding-left: 12px; width: 19%; }
.compact .energy-orb { width: 94px; height: 94px; margin-left: 20px; }
.compact .energy-caption { width: 134px; }
.compact .energy-value { font-size: 35px; }
.compact .end-turn { font-size: 22px; height: 65px; }
.narrow .preview-label { display: none; }
.narrow .bottom-area { height: 255px; flex-wrap: wrap; }
.narrow .player-status { width: 20%; }
.narrow .hand-region { width: 60%; }
.narrow .controls { width: 20%; padding-left: 5px; padding-right: 0; }
.narrow .intent-column { width: 130px; }
.narrow .map { width: 130px; height: 100px; }
.narrow .inventory-icon { width: 38px; height: 38px; margin-right: 5px; }
.narrow .player-health-track { width: 120px; }
.narrow .block-text { font-size: 16px; }
.narrow .energy-orb { margin-left: 5px; }
.narrow .energy-caption { width: 110px; font-size: 18px; }
.narrow .end-turn { font-size: 17px; }
.narrow .pile .eyebrow { font-size: 8px; letter-spacing: 0; }
.portrait-layout .arena { min-height: 400px; }
.portrait-layout .bottom-area { height: 440px; }
.portrait-layout .player-status { width: 28%; }
.portrait-layout .hand-region { width: 72%; height: 255px; }
.portrait-layout .controls { width: 100%; flex-direction: row; align-items: center; justify-content: flex-end; padding: 10px; }
.portrait-layout .end-turn { width: 220px; margin-right: 20px; margin-bottom: 0; }
.portrait-layout .pile-row { width: 210px; }
.portrait-layout .enemy-status { width: 160px; }
.portrait-layout .enemy-name { font-size: 17px; }
.top-bar { -unity-slice-scale: 0.15; -unity-background-image-tint-color: rgb(140, 140, 140); }
.parchment { -unity-slice-scale: 0.25; }
.hand-card { -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0; }
.deck-stack { width: 40px; height: 43px; margin-top: 8px; border-width: 1px; border-color: var(--muted); rotate: -12deg; background-color: rgb(27, 23, 20); }
.deck-stack-inner { position: absolute; left: 6px; top: -4px; width: 34px; height: 43px; border-width: 1px; border-color: var(--muted); rotate: 18deg; background-color: rgb(36, 28, 22); }
.orb-rim { position: absolute; left: -9px; right: -9px; top: -9px; bottom: -9px; border-radius: 70px; border-width: 2px; border-color: rgb(65, 63, 59); border-top-color: rgb(173, 159, 135); border-bottom-color: rgb(126, 113, 93); }
.orb-inner { position: absolute; left: 4px; right: 4px; top: 4px; bottom: 4px; border-radius: 60px; border-width: 2px; border-color: rgb(19, 76, 86); border-bottom-color: rgb(6, 22, 30); }
.orb-glint { position: absolute; left: 23%; top: 11%; width: 34%; height: 9%; background-color: rgba(44, 108, 120, 0.16); border-radius: 20px; rotate: -25deg; }

